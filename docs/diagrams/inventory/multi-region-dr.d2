# Generated by make inventory from a mock plan of multi-region-dr/terraform:
# change scripts/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "multi-region-dr/terraform: 67 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

