# Generated by make inventory from a mock plan of serverless-variant/terraform:
# change scripts/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "serverless-variant/terraform: 48 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 3
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "module.counter · 4" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
    s1: "CloudWatch · 1" {shape: image; icon: ../icons/cloudwatch.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "IAM · 2" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "Lambda · 1" {shape: image; icon: ../icons/lambda.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p2: "module.transcode · 4" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
    s1: "CloudWatch · 1" {shape: image; icon: ../icons/cloudwatch.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "IAM · 2" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "Lambda · 1" {shape: image; icon: ../icons/lambda.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p3: "module.transcode_flow · 19" {
    class: workload
    grid-rows: 2
    grid-columns: 3
    grid-gap: 24
    s1: "CloudWatch · 3" {shape: image; icon: ../icons/cloudwatch.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "EventBridge · 5" {shape: image; icon: ../icons/eventbridge.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "IAM · 4" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s4: "S3 · 6" {shape: image; icon: ../icons/s3.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s5: "Step Functions · 1" {shape: image; icon: ../icons/step-functions.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p4: "module.view_counter · 2" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "DynamoDB · 1" {shape: image; icon: ../icons/dynamodb.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "Lambda · 1" {shape: image; icon: ../icons/lambda.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p5: "module.view_ingest · 19" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
    s1: "API Gateway · 13" {shape: image; icon: ../icons/api-gateway.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "IAM · 2" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "SQS · 4" {shape: image; icon: ../icons/sqs.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
}
