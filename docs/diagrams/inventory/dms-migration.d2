# Generated by make inventory from a mock plan of dms-migration/terraform:
# change scripts/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "dms-migration/terraform: 56 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 3
  grid-columns: 3
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "module.aws_network · 6" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
