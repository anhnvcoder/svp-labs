# Generated by make inventory from a mock plan of multi-account-networking/core:
# change scripts/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "multi-account-networking/core: 128 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

