# Generated by make inventory from a mock plan of multi-account-networking/hybrid:
# change scripts/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "multi-account-networking/hybrid: 76 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 3
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "main.tf · 3" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "VPC · 3" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p2: "module.resolver · 14" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "Route 53 · 4" {shape: image; icon: ../icons/route53.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "VPC · 10" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p3: "module.service_prd · 8" {
    class: workload
    grid-rows: 1
