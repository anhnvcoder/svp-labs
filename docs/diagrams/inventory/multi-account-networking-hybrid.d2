    grid-gap: 24
    s1: "ELB · 4" {shape: image; icon: ../icons/elb.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "PrivateLink · 3" {shape: image; icon: ../icons/privatelink.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "Systems Manager · 1" {shape: image; icon: ../icons/systems-manager.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p4: "module.service_stg · 3" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "PrivateLink · 1" {shape: image; icon: ../icons/privatelink.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "VPC · 2" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p5: "module.site · 42" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
