# Generated by make inventory from a mock plan of data-scaling/postgres:
# change scripts/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "data-scaling/postgres: 40 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 3
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "module.aurora · 7" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
    s1: "Aurora · 3" {shape: image; icon: ../icons/aurora.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "RDS · 1" {shape: image; icon: ../icons/rds.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "VPC · 3" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p2: "module.db_secret · 2" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "Secrets Manager · 2" {shape: image; icon: ../icons/secrets-manager.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p3: "module.loader · 8" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
    s1: "EC2 · 1" {shape: image; icon: ../icons/ec2.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "IAM · 4" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "VPC · 3" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p4: "module.network · 10" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "VPC · 10" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p5: "module.rds · 5" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "RDS · 3" {shape: image; icon: ../icons/rds.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "VPC · 2" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p6: "module.rds_proxy · 8" {
    class: workload
    grid-rows: 1
    grid-columns: 3
    grid-gap: 24
    s1: "IAM · 2" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "RDS · 3" {shape: image; icon: ../icons/rds.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s3: "VPC · 3" {shape: image; icon: ../icons/vpc.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
}
